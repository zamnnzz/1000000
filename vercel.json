{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/game/:slug", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/screenshots/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(app.js|data.js|styles.css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
